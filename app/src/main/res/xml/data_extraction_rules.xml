<?xml version="1.0" encoding="utf-8"?><!--
   On Android 12+ allowBackup="false" doesn't stop device-to-device transfer, so it's excluded here.
   The encrypted device ID can't be decrypted on another device: its key stays in that device's Keystore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
